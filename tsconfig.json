{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "allowJs": true, "checkJs": false, "noEmit": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"]
  },
  "include": ["docs/.vitepress/**/*.ts", "docs/.vitepress/**/*.vue"],
  "exclude": ["docs/.vitepress/dist", "docs/.vitepress/cache"]
}
